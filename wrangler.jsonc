{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "knockout-viewer",
  "compatibility_date": "2026-08-26",
  "preview_urls": true,
  "build": {
    "command": "node scripts/diagnose-build.mjs"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
