  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "6.1.0",
    "typescript": "^5.9.2",
    "vite": "^8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.125.0"
  },
  "engines": {
    "node": ">=22"
