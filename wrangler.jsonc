{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "knockout-viewer",
  "compatibility_date": "2026-08-26",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "knockout.lucakollmer.com",
      "custom_domain": true
    }
  ]
}
